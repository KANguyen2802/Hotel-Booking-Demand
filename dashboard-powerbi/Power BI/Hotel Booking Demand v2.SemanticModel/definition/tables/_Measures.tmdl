		displayFolder: 07 KPI Cards
		lineageTag: 1db85ab0-c10f-4ac0-88ab-aa8c76131737

	/// YoY tháng cuối — invert màu.
	measure 'Cancel Rate YoY %' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR Curr =
			    CALCULATE (
			        [Cancel Rate],
			        DATESBETWEEN ( Dim_Date[Date], LastMonth, EOMONTH ( LastMonth, 0 ) )
			    )
			VAR PyMonth = EDATE ( LastMonth, -12 )
			VAR Prev =
			    CALCULATE (
			        [Cancel Rate],
			        DATESBETWEEN ( Dim_Date[Date], PyMonth, EOMONTH ( PyMonth, 0 ) )
			    )
			RETURN
			DIVIDE ( Curr - Prev, Prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07 KPI Cards
		lineageTag: 6bcb196b-4210-4b53-9369-dea2ffc02008

