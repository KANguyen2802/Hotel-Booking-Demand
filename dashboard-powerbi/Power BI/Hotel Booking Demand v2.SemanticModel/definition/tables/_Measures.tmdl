/// Home table for all DAX measures (organized by display folders)
table _Measures
	lineageTag: efaf392e-7950-4940-b1d4-1ba2948b2160

	measure 'Total Bookings' = SUM(Fact_Revpar_Monthly[total_bookings])
		formatString: #,##0
		displayFolder: 01 Overview & RevPAR
		lineageTag: 5c7f6691-c059-4895-959a-4a5d4e6e9c19

	measure 'Successful Bookings' = SUM(Fact_Revpar_Monthly[successful_bookings])
		formatString: #,##0
		displayFolder: 01 Overview & RevPAR
		lineageTag: c50c99ee-50e8-4e6d-90c6-2de77a78fae6

	measure 'Canceled Bookings (Monthly)' = SUM(Fact_Revpar_Monthly[canceled_bookings])
		formatString: #,##0
		displayFolder: 01 Overview & RevPAR
		lineageTag: 453d2082-e785-436e-a818-b82c64fb5083

	measure 'Total Revenue' = SUM(Fact_Revpar_Monthly[total_revenue])
		formatString: #,##0.00
		displayFolder: 01 Overview & RevPAR
		lineageTag: fc0d67f8-851d-4a42-ac54-2c0ee55a7a99

	measure 'Cancel Rate (Monthly)' = DIVIDE([Canceled Bookings (Monthly)], [Total Bookings])
		formatString: 0.00%
		displayFolder: 01 Overview & RevPAR
		lineageTag: b428b49a-7cd9-4290-a69e-250f9ca6f099

	/// Guide ADR — renamed because column [adr] exists (name clash)
	measure 'ADR (wtd)' =
			DIVIDE(
			    SUMX(Fact_Revpar_Monthly, Fact_Revpar_Monthly[adr] * Fact_Revpar_Monthly[successful_bookings]),
			    SUM(Fact_Revpar_Monthly[successful_bookings])
			)
		formatString: #,##0.00
		displayFolder: 01 Overview & RevPAR
		lineageTag: 7413efb4-b567-47fa-b559-b7ba5dc6a5f7

	/// Guide Occupancy Rate — renamed because column [occupancy_rate] exists
	measure 'Occupancy Rate (wtd)' =
			DIVIDE(
			    SUMX(Fact_Revpar_Monthly, Fact_Revpar_Monthly[occupancy_rate] * Fact_Revpar_Monthly[total_bookings]),
			    SUM(Fact_Revpar_Monthly[total_bookings])
			)
		formatString: 0.00%
		displayFolder: 01 Overview & RevPAR
		lineageTag: 259619d8-0a01-4171-b22b-9fb607278fb1

	/// Guide RevPAR — renamed because column [revpar] exists
	measure 'RevPAR (wtd)' =
			DIVIDE(
			    SUMX(Fact_Revpar_Monthly, Fact_Revpar_Monthly[revpar] * Fact_Revpar_Monthly[total_bookings]),
			    SUM(Fact_Revpar_Monthly[total_bookings])
			)
		formatString: #,##0.00
		displayFolder: 01 Overview & RevPAR
		lineageTag: d7647df6-cd7a-45ba-bec6-ea55e609fd59

	measure 'Latest Month (YearMonth)' = CALCULATE(MAX(Fact_Revpar_Monthly[year_month]), ALLSELECTED(Fact_Revpar_Monthly))
		formatString: yyyy-mm
		displayFolder: 01 Overview & RevPAR
		lineageTag: b994d06c-cf15-489f-a5da-7c82fa3f34b5

	measure 'RevPAR (Latest Month)' =
			VAR LatestYM = [Latest Month (YearMonth)]
			RETURN
			CALCULATE(
			    [RevPAR (wtd)],
			    TREATAS({LatestYM}, Fact_Revpar_Monthly[year_month])
			)
		formatString: #,##0.00
		displayFolder: 01 Overview & RevPAR
		lineageTag: 4b92178f-7958-46b6-9b95-734c3d0ea75f

	measure 'RevPAR PM' =
			VAR LastMonth = [Latest Fact Month Start]
			RETURN
			CALCULATE(
			    [RevPAR (wtd)],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EDATE(LastMonth, -1),
			        EOMONTH(LastMonth, -1)
			    )
			)
		formatString: #,##0.00
		displayFolder: 02 Time Intelligence
		lineageTag: a661347f-22bf-44d2-a242-c4e51f282ad5

	measure 'RevPAR PY' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR PyMonth = EDATE(LastMonth, -12)
			RETURN
			CALCULATE(
			    [RevPAR (wtd)],
			    DATESBETWEEN(Dim_Date[Date], PyMonth, EOMONTH(PyMonth, 0))
			)
		formatString: #,##0.00
		displayFolder: 02 Time Intelligence
		lineageTag: 00bd2d6a-3f3f-44ac-b62f-5633c752173a

	measure 'RevPAR MoM %' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentVal =
			    CALCULATE(
			        [RevPAR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			DIVIDE(CurrentVal - [RevPAR PM], [RevPAR PM])
		formatString: 0.00%
		displayFolder: 02 Time Intelligence
		lineageTag: 0c8738d8-0c32-464f-80e7-030d565e5519

	measure 'RevPAR YoY %' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentVal =
			    CALCULATE(
			        [RevPAR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			DIVIDE(CurrentVal - [RevPAR PY], [RevPAR PY])
		formatString: 0.00%
		displayFolder: 02 Time Intelligence
		lineageTag: 3d0ed14c-ebcd-49ec-8934-1f8eb8b46bb8

	measure 'Total Revenue PM' =
			VAR LastMonth = [Latest Fact Month Start]
			RETURN
			CALCULATE(
			    [Total Revenue],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EDATE(LastMonth, -1),
			        EOMONTH(LastMonth, -1)
			    )
			)
		formatString: #,##0.00
		displayFolder: 02 Time Intelligence
		lineageTag: a0f63690-27c8-4379-9755-3b9d8bf977f2

	measure 'Total Revenue MoM %' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentVal =
			    CALCULATE(
			        [Total Revenue],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			DIVIDE(CurrentVal - [Total Revenue PM], [Total Revenue PM])
		formatString: 0.00%
		displayFolder: 02 Time Intelligence
		lineageTag: 288a8d5c-0a5b-4f5a-b598-b374eed0cc8f

	measure 'Cancel Rate PM' =
			VAR LastMonth = [Latest Fact Month Start]
			RETURN
			CALCULATE(
			    [Cancel Rate (Monthly)],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EDATE(LastMonth, -1),
			        EOMONTH(LastMonth, -1)
			    )
			)
		formatString: 0.00%
		displayFolder: 02 Time Intelligence
		lineageTag: 92d07d9f-3df6-43c9-ac51-d2011bb1ddab

	/// Guide: Cancel Rate Δ pp (MoM)
	measure 'Cancel Rate Delta pp (MoM)' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentVal =
			    CALCULATE(
			        [Cancel Rate (Monthly)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			(CurrentVal - [Cancel Rate PM]) * 100
		formatString: 0.00
		displayFolder: 02 Time Intelligence
		lineageTag: 95708b99-c35c-4dbe-a455-1c9051d05f21

	measure 'ADR PM' =
			VAR LastMonth = [Latest Fact Month Start]
			RETURN
			CALCULATE(
			    [ADR (wtd)],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EDATE(LastMonth, -1),
			        EOMONTH(LastMonth, -1)
			    )
			)
		formatString: #,##0.00
		displayFolder: 03 Decomposition
		lineageTag: fb5bf78f-5f68-4296-b7a0-9530dfecb075

	measure 'Occupancy PM' =
			VAR LastMonth = [Latest Fact Month Start]
			RETURN
			CALCULATE(
			    [Occupancy Rate (wtd)],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EDATE(LastMonth, -1),
			        EOMONTH(LastMonth, -1)
			    )
			)
		formatString: 0.00%
		displayFolder: 03 Decomposition
		lineageTag: d9255080-cd84-4efa-9f94-406d9c1f5cc0

	/// Guide: Δ RevPAR from ADR (MoM)
	measure 'Delta RevPAR from ADR (MoM)' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentADR =
			    CALCULATE(
			        [ADR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			[Occupancy PM] * (CurrentADR - [ADR PM])
		formatString: #,##0.00
		displayFolder: 03 Decomposition
		lineageTag: 9138134c-6d6e-4bd7-8511-b0975de15c70

	/// Guide: Δ RevPAR from Occupancy (MoM)
	measure 'Delta RevPAR from Occupancy (MoM)' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentADR =
			    CALCULATE(
			        [ADR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			VAR CurrentOcc =
			    CALCULATE(
			        [Occupancy Rate (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			CurrentADR * (CurrentOcc - [Occupancy PM])
		formatString: #,##0.00
		displayFolder: 03 Decomposition
		lineageTag: 461209ba-8f89-490d-af17-9bc9bd204fa5

	measure 'Residual (MoM)' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentRevPAR =
			    CALCULATE(
			        [RevPAR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			CurrentRevPAR - ([RevPAR PM] + [Delta RevPAR from ADR (MoM)] + [Delta RevPAR from Occupancy (MoM)])
		formatString: #,##0.00
		displayFolder: 03 Decomposition
		lineageTag: 3fdef439-6cf0-42d3-8191-feb7afb35eab

	/// Guide: ADR Delta Mult
	measure 'ADR Delta Mult' = 1 + [ADR Change % Value] / 100
		formatString: 0.0000
		displayFolder: 06 Simulator
		lineageTag: 1cea0397-7b37-4708-9c66-bc92af1f6c90

	measure 'Occ Delta pp' = [Occupancy Change (pp) Value] / 100
		formatString: 0.00%
		displayFolder: 06 Simulator
		lineageTag: 3b5355c4-329e-42b4-b71e-5c8c44cad265

	measure 'Cancel Delta pp' = [Cancel Rate Change (pp) Value] / 100
		formatString: 0.00%
		displayFolder: 06 Simulator
		lineageTag: b6bebe31-2474-433b-ae42-da4826e0ebb0

	measure 'Elasticity On' = SELECTEDVALUE('Elasticity Toggle'[Toggle], "Off") = "On"
		displayFolder: 06 Simulator
		lineageTag: 367f07aa-2b5b-4612-92a2-a9f3b1038f34

	measure 'Elasticity Adj' = IF([Elasticity On], ([ADR Delta Mult] - 1) * -0.25, 0)
		formatString: 0.0000
		displayFolder: 06 Simulator
		lineageTag: 5d6ed1f9-d754-41f2-a5dc-485bf272e4c2

	measure 'RevPAR (Baseline)' =
			DIVIDE(
			    SUMX(Fact_Revpar_Monthly, Fact_Revpar_Monthly[adr] * Fact_Revpar_Monthly[occupancy_rate] * Fact_Revpar_Monthly[total_bookings]),
			    SUM(Fact_Revpar_Monthly[total_bookings])
			)
		formatString: #,##0.00
		displayFolder: 06 Simulator
		lineageTag: 3aac068e-1822-46c0-8a58-b93cbcca4914

	measure 'RevPAR (Scenario)' =
			VAR AdrMult = [ADR Delta Mult]
			VAR OccPp = [Occ Delta pp] + [Elasticity Adj]
			VAR CxPp = [Cancel Delta pp]
			RETURN
			DIVIDE(
			    SUMX(
			        Fact_Revpar_Monthly,
			        VAR AdrSim = Fact_Revpar_Monthly[adr] * AdrMult
			        VAR OccStep1 = MIN(0.99, MAX(0.05, Fact_Revpar_Monthly[occupancy_rate] + OccPp))
			        VAR OccSim = MIN(0.99, MAX(0.05, OccStep1 - CxPp * 0.5))
			        RETURN AdrSim * OccSim * Fact_Revpar_Monthly[total_bookings]
			    ),
			    SUM(Fact_Revpar_Monthly[total_bookings])
			)
		formatString: #,##0.00
		displayFolder: 06 Simulator
		lineageTag: e96b5a80-c236-485b-bae0-c2a769445524

	measure 'Revenue (Scenario)' =
			VAR AdrMult = [ADR Delta Mult]
			VAR OccPp = [Occ Delta pp] + [Elasticity Adj]
			VAR CxPp = [Cancel Delta pp]
			RETURN
			SUMX(
			    Fact_Revpar_Monthly,
			    VAR RevparBase = Fact_Revpar_Monthly[adr] * Fact_Revpar_Monthly[occupancy_rate]
			    VAR AdrSim = Fact_Revpar_Monthly[adr] * AdrMult
			    VAR OccStep1 = MIN(0.99, MAX(0.05, Fact_Revpar_Monthly[occupancy_rate] + OccPp))
			    VAR OccSim = MIN(0.99, MAX(0.05, OccStep1 - CxPp * 0.5))
			    VAR RevparSim = AdrSim * OccSim
			    VAR Ratio = DIVIDE(RevparSim, RevparBase, 1)
			    RETURN Fact_Revpar_Monthly[total_revenue] * Ratio
			)
		formatString: #,##0.00
		displayFolder: 06 Simulator
		lineageTag: 4ed0c157-ecf6-48ac-b44c-5ca08fd8beb0

	measure 'Delta RevPAR % (Scenario)' = DIVIDE([RevPAR (Scenario)] - [RevPAR (Baseline)], [RevPAR (Baseline)])
		formatString: 0.00%
		displayFolder: 06 Simulator
		lineageTag: 77ea81c0-93a6-44c1-b4f3-53f6e4c33991

	measure 'Delta Revenue % (Scenario)' = DIVIDE([Revenue (Scenario)] - [Total Revenue], [Total Revenue])
		formatString: 0.00%
		displayFolder: 06 Simulator
		lineageTag: 3549e419-c408-45e6-8183-5019ef34d8fe

	measure 'ADR (Scenario)' = [ADR (wtd)] * [ADR Delta Mult]
		formatString: #,##0.00
		displayFolder: 06 Simulator
		lineageTag: 5c489ad5-6875-4671-a748-1c3eb5f1e7e4

	measure 'Room Nights Sold' = CALCULATE(SUM(Fact_Booking[total_nights]), Fact_Booking[is_canceled] = 0)
		formatString: #,##0
		displayFolder: 04 Room Type
		lineageTag: fa1b82ee-4438-44af-a690-c67c77f070ba

	measure 'Revenue (Booking)' = SUM(Fact_Booking[revenue])
		formatString: #,##0.00
		displayFolder: 04 Room Type
		lineageTag: 0c5f9feb-2a9e-4e32-9ab2-2bdbbc8c6781

	measure 'RevPAR (Reserved Room)' = DIVIDE([Revenue (Booking)], [Room Nights Sold])
		formatString: #,##0.00
		displayFolder: 04 Room Type
		lineageTag: 99d903f3-3b55-478b-b20f-c3238c63e267

	measure 'RevPAR (Assigned Room)' =
			CALCULATE(
			    DIVIDE([Revenue (Booking)], [Room Nights Sold]),
			    USERELATIONSHIP(Dim_RoomType[room_type], Fact_Booking[assigned_room_type])
			)
		formatString: #,##0.00
		displayFolder: 04 Room Type
		lineageTag: 8d023190-077b-4351-a9b3-c3a8b3fb545f

	measure Bookings = COUNTROWS(Fact_Booking)
		formatString: #,##0
		displayFolder: 05 Cancellation
		lineageTag: 67717163-09af-4c6d-92bf-c9da23cc8484

	measure 'Canceled Bookings' = CALCULATE(COUNTROWS(Fact_Booking), Fact_Booking[is_canceled] = 1)
		formatString: #,##0
		displayFolder: 05 Cancellation
		lineageTag: 66193c0f-c6b8-4dc3-9448-8a738a2e66e6

	measure 'No-Show Bookings' = CALCULATE(COUNTROWS(Fact_Booking), Fact_Booking[reservation_status] = "No-Show")
		formatString: #,##0
		displayFolder: 05 Cancellation
		lineageTag: 7e1420a9-a87d-4947-81d5-5c643359bacb

	measure 'Check-Out Bookings' = CALCULATE(COUNTROWS(Fact_Booking), Fact_Booking[reservation_status] = "Check-Out")
		formatString: #,##0
		displayFolder: 05 Cancellation
		lineageTag: 07398d74-bfba-41d1-b4c1-de894721346d

	measure 'Cancel Rate' = DIVIDE([Canceled Bookings], [Bookings])
		formatString: 0.00%
		displayFolder: 05 Cancellation
		lineageTag: c68dd16e-a978-45b5-be78-4525cb27d038

	measure 'No-Show Rate' = DIVIDE([No-Show Bookings], [Bookings])
		formatString: 0.00%
		displayFolder: 05 Cancellation
		lineageTag: 345a9a48-3abd-408f-be0c-72a309ab8ef3

	/// Proxy estimate — not accounting
	measure 'Lost Revenue (est.)' =
			VAR CxRate = [Cancel Rate]
			VAR Denom = MAX(1 - CxRate, 0.01)
			RETURN [Revenue (Booking)] * DIVIDE(CxRate, Denom) * 0.35
		formatString: #,##0.00
		displayFolder: 05 Cancellation
		lineageTag: 489e0bf8-a2f8-4fc5-8a04-44dd8ae37fc9

	measure 'Segment Cancel Rate (min 50)' = IF([Bookings] >= 50, [Cancel Rate])
		formatString: 0.00%
		displayFolder: 05 Cancellation
		lineageTag: 68791ab7-b5e5-4b3d-b52a-26be61a0212e

	measure 'Funnel Value' =
			SWITCH(
			    SELECTEDVALUE('Funnel Stage'[Stage]),
			    "Bookings", [Bookings],
			    "After cancel leak", [Bookings] - [Canceled Bookings],
			    "Check-Out", [Check-Out Bookings]
			)
		formatString: #,##0
		displayFolder: 05 Cancellation
		lineageTag: d173763f-db32-40e7-8685-63bbd54ae52f

	/// Đọc lever khi slicer không có Single value: Greater than or equal to → MIN; Less than or equal to → MAX; full range → default 5.
	measure 'ADR Change % Value' =
			VAR Lo = MIN('ADR Change %'[ADR Change %])
			VAR Hi = MAX('ADR Change %'[ADR Change %])
			VAR AllMin = CALCULATE(MIN('ADR Change %'[ADR Change %]), ALL('ADR Change %'))
			VAR AllMax = CALCULATE(MAX('ADR Change %'[ADR Change %]), ALL('ADR Change %'))
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Lo), 5,
			    Lo = AllMin && Hi = AllMax, 5,
			    Lo = Hi, Lo,
			    Hi = AllMax, Lo,
			    Lo = AllMin, Hi,
			    5
			)
		formatString: 0
		displayFolder: 06 Simulator
		lineageTag: a6c1d37e-882c-4128-82c3-6ff8886c60bb

	/// Lever Occupancy: slicer Greater than or equal to (một núm). Default -2 khi chưa lọc.
	measure 'Occupancy Change (pp) Value' =
			VAR Lo = MIN('Occupancy Change (pp)'[Occupancy Change (pp)])
			VAR Hi = MAX('Occupancy Change (pp)'[Occupancy Change (pp)])
			VAR AllMin = CALCULATE(MIN('Occupancy Change (pp)'[Occupancy Change (pp)]), ALL('Occupancy Change (pp)'))
			VAR AllMax = CALCULATE(MAX('Occupancy Change (pp)'[Occupancy Change (pp)]), ALL('Occupancy Change (pp)'))
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Lo), -2,
			    Lo = AllMin && Hi = AllMax, -2,
			    Lo = Hi, Lo,
			    Hi = AllMax, Lo,
			    Lo = AllMin, Hi,
			    -2
			)
		formatString: 0
		displayFolder: 06 Simulator
		lineageTag: 7a4915ef-54be-4c6f-adde-4c7a3aee8176

	/// Lever Cancel: slicer Greater than or equal to (một núm). Default 0 khi chưa lọc.
	measure 'Cancel Rate Change (pp) Value' =
			VAR Lo = MIN('Cancel Rate Change (pp)'[Cancel Rate Change (pp)])
			VAR Hi = MAX('Cancel Rate Change (pp)'[Cancel Rate Change (pp)])
			VAR AllMin = CALCULATE(MIN('Cancel Rate Change (pp)'[Cancel Rate Change (pp)]), ALL('Cancel Rate Change (pp)'))
			VAR AllMax = CALCULATE(MAX('Cancel Rate Change (pp)'[Cancel Rate Change (pp)]), ALL('Cancel Rate Change (pp)'))
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Lo), 0,
			    Lo = AllMin && Hi = AllMax, 0,
			    Lo = Hi, Lo,
			    Hi = AllMax, Lo,
			    Lo = AllMin, Hi,
			    0
			)
		formatString: 0
		displayFolder: 06 Simulator
		lineageTag: 5e1b5d98-d83e-4b30-bfe1-2d6b524bd428

	/// Tháng fact mới nhất trong context (ALLSELECTED). Dùng để Card MoM/YoY không lọc ngày vẫn so đúng tháng cuối.
	measure 'Latest Fact Month Start' = MAX(Fact_Revpar_Monthly[MonthStartDate])
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: 02 Time Intelligence
		lineageTag: 86710975-4be6-4145-9710-94da225dc7d3

	/// Label MoM cho cột Revenue trên chart dual-axis: tam giác đặc ▲/▼ so với tháng trước (giống HTML pctDelta). Tháng đầu không có tháng trước → blank.
	measure 'Revenue MoM Label' =
			VAR MoM = [Total Revenue MoM %]
			VAR Arrow =
			    SWITCH(
			        TRUE(),
			        MoM > 0, UNICHAR(9650),
			        MoM < 0, UNICHAR(9660),
			        UNICHAR(9654)
			    )
			RETURN
			IF(
			    ISBLANK(MoM),
			    BLANK(),
			    Arrow & " " & FORMAT(ABS(MoM), "0.0%")
			)
		displayFolder: 02 Time Intelligence
		lineageTag: 76f9542f-5628-4c94-8095-b533064689f7

	/// 1 = tăng, -1 = giảm, 0 = đi ngang. Dùng cho màu chữ label (xanh/đỏ).
	measure 'Revenue MoM Sign' =
			VAR MoM = [Total Revenue MoM %]
			RETURN
			IF(ISBLANK(MoM), BLANK(), SIGN(MoM))
		formatString: 0
		displayFolder: 02 Time Intelligence
		lineageTag: ac30bfd6-2464-492d-8454-5460b47c451a

	/// Tổng đêm đặt (cả hủy) — khớp HTML customer_type_monthly.room_nights. Dùng cho toggle Occupancy / room-nights.
	measure 'Room Nights' = SUM(Fact_Booking[total_nights])
		formatString: #,##0
		displayFolder: 01 Overview & RevPAR
		lineageTag: 87fcea10-67a9-4b9f-b578-3c1cbe819316

	/// Giá trị từng bước waterfall RevPAR MoM. Curr RevPAR neo tháng fact mới nhất (giống các measure 03 Decomposition) để chart đúng khi không có slicer ngày.
	measure 'Bridge Value' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR CurrentRevPAR =
			    CALCULATE(
			        [RevPAR (wtd)],
			        DATESBETWEEN(Dim_Date[Date], LastMonth, EOMONTH(LastMonth, 0))
			    )
			RETURN
			SWITCH(
			    SELECTEDVALUE('Bridge Step'[Step]),
			    "Prev RevPAR", [RevPAR PM],
			    "Δ ADR", [Delta RevPAR from ADR (MoM)],
			    "Δ Occupancy", [Delta RevPAR from Occupancy (MoM)],
			    "Curr RevPAR", CurrentRevPAR
			)
		formatString: #,##0.00
		displayFolder: 03 Decomposition
		lineageTag: 0df74123-6061-44cd-8b59-3200aa127a29

	/// Sensitivity 4 cột HTML: Baseline / adr_sim×occ / adr×occ_sim / Combined. Axis = Sensitivity Scenario[Scenario].
	measure 'Sensitivity RevPAR' =
			VAR AdrMult = [ADR Delta Mult]
			VAR OccPp = [Occ Delta pp] + [Elasticity Adj]
			VAR CxPp = [Cancel Delta pp]
			VAR AdrOnly =
			    DIVIDE(
			        SUMX(
			            Fact_Revpar_Monthly,
			            Fact_Revpar_Monthly[adr] * AdrMult
			                * Fact_Revpar_Monthly[occupancy_rate]
			                * Fact_Revpar_Monthly[total_bookings]
			        ),
			        SUM(Fact_Revpar_Monthly[total_bookings])
			    )
			VAR OccOnly =
			    DIVIDE(
			        SUMX(
			            Fact_Revpar_Monthly,
			            VAR OccStep1 = MIN(0.99, MAX(0.05, Fact_Revpar_Monthly[occupancy_rate] + OccPp))
			            VAR OccSim = MIN(0.99, MAX(0.05, OccStep1 - CxPp * 0.5))
			            RETURN Fact_Revpar_Monthly[adr] * OccSim * Fact_Revpar_Monthly[total_bookings]
			        ),
			        SUM(Fact_Revpar_Monthly[total_bookings])
			    )
			RETURN
			SWITCH(
			    SELECTEDVALUE('Sensitivity Scenario'[Scenario]),
			    "Baseline", [RevPAR (Baseline)],
			    "ADR only", AdrOnly,
			    "Occ only", OccOnly,
			    "Combined", [RevPAR (Scenario)]
			)
		formatString: #,##0.00
		displayFolder: 06 Simulator
		lineageTag: 4c060bf5-76ca-49fe-a7fd-b560175a8878

	/// CY = năm đang chọn trên slicer Dim_Date[Year]. Một năm → năm đó; nhiều năm / không slicer → MAX năm trong lựa chọn. ALLSELECTED để sparkline (trục tháng) không làm lệch năm.
	measure 'KPI CY Year' = MAXX ( ALLSELECTED ( Dim_Date[Year] ), Dim_Date[Year] )
		formatString: 0
		isHidden
		displayFolder: 07 KPI Cards
		lineageTag: bb0b6588-20f5-4c9f-bb61-d995ea7aa34f

	/// PY = năm đang chọn (CY) − 1.
	measure 'KPI PY Year' = [KPI CY Year] - 1
		formatString: 0
		isHidden
		displayFolder: 07 KPI Cards
		lineageTag: c5289ac0-1e6c-4766-89f6-156e0a4dbbf4

	/// Bookings năm CY, cùng tháng-trong-năm với CY (splitCyPy).
	measure 'Total Bookings (CY)' =
			VAR CyYear = [KPI CY Year]
			VAR SlicerMonths =
			    CALCULATETABLE ( VALUES ( Dim_Date[MonthNumber] ), ALLSELECTED ( Dim_Date ) )
			VAR MonthsInCY =
			    CALCULATETABLE (
			        VALUES ( Fact_Revpar_Monthly[month_number] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Revpar_Monthly[year] = CyYear
			    )
			VAR Months = INTERSECT ( SlicerMonths, MonthsInCY )
			RETURN
			CALCULATE (
			    [Total Bookings],
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Year] = CyYear,
			    TREATAS ( Months, Dim_Date[MonthNumber] )
			)
		formatString: #,##0
		displayFolder: 07 KPI Cards
		lineageTag: 6f666d58-eb28-405a-b3e1-236ffc333528

	/// Bookings năm PY, chỉ các tháng có mặt ở CY.
