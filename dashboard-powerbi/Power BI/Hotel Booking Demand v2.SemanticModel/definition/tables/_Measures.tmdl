		displayFolder: 07 KPI Cards
		lineageTag: 34496b57-6cd6-4a7e-8448-f4ef33d23180

	/// Sparkline Canceled bookings PY.
	measure 'Canceled Bookings (PY by month)' =
			VAR PyYear = [KPI PY Year]
			VAR Mo = SELECTEDVALUE ( Dim_Date[MonthNumber] )
			RETURN
			IF (
			    NOT ISBLANK ( Mo ),
			    CALCULATE (
			        [Canceled Bookings],
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Year] = PyYear,
			        Dim_Date[MonthNumber] = Mo
			    )
			)
		formatString: #,##0
		displayFolder: 07 KPI Cards
		lineageTag: 380dcfec-fb70-4d12-91b9-d8893d620989

