	/// YoY: tháng fact cuối vs cùng tháng năm trước (HTML kpiTrendSpec).
	measure 'Total Bookings YoY %' =
			VAR LastMonth = [Latest Fact Month Start]
			VAR Curr =
			    CALCULATE (
			        [Total Bookings],
			        DATESBETWEEN ( Dim_Date[Date], LastMonth, EOMONTH ( LastMonth, 0 ) )
			    )
			VAR PyMonth = EDATE ( LastMonth, -12 )
			VAR Prev =
			    CALCULATE (
			        [Total Bookings],
			        DATESBETWEEN ( Dim_Date[Date], PyMonth, EOMONTH ( PyMonth, 0 ) )
			    )
			RETURN
			DIVIDE ( Curr - Prev, Prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07 KPI Cards
		lineageTag: 6dd1da43-9593-4b12-ba10-a1a674a63d6a

