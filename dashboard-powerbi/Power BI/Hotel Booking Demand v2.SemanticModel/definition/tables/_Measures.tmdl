	/// Occupancy scenario — SUMX từng dòng rồi weighted, giống simulate().
	measure 'Occupancy (Scenario)' =
			VAR OccPp = [Occ Delta pp] + [Elasticity Adj]
			VAR CxPp = [Cancel Delta pp]
			RETURN
			DIVIDE (
			    SUMX (
			        Fact_Revpar_Monthly,
			        VAR OccStep1 =
			            MIN ( 0.99, MAX ( 0.05, Fact_Revpar_Monthly[occupancy_rate] + OccPp ) )
			        VAR OccSim =
			            MIN ( 0.99, MAX ( 0.05, OccStep1 - CxPp * 0.5 ) )
			        RETURN OccSim * Fact_Revpar_Monthly[total_bookings]
			    ),
			    SUM ( Fact_Revpar_Monthly[total_bookings] )
			)
		formatString: 0.00%
		displayFolder: 06 Simulator
		lineageTag: cbc1aa2b-406c-4ae8-a474-13d5958eeb1e

	/// Thẻ Simulator ADR → Occ: giá trước → sau.
	measure 'ADR Occ Transition' = FORMAT ( [ADR (wtd)], "€#,##0.00" ) & " → " & FORMAT ( [ADR (Scenario)], "€#,##0.00" )
		displayFolder: 06 Simulator
		lineageTag: 39fec127-b222-484f-af87-b7baec281601

